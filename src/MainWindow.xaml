<Window x:Class="DualPanelBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DualPanelBrowser"
        Title="DualPanel Browser" Height="800" Width="1440"
        Icon="pack://application:,,,/assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <Grid KeyDown="Window_KeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#E0E0E0">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#0078D4"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>
        <Border x:Name="LeftBorder" Grid.Column="0" BorderBrush="Transparent" BorderThickness="2"
                AllowDrop="True"
                MouseDown="Pane_MouseDown" MouseEnter="Pane_MouseEnter"
                DragEnter="Pane_DragEnter" DragOver="Pane_DragOver" DragLeave="Pane_DragLeave" Drop="Pane_Drop">
            <local:BrowserPane x:Name="LeftPane"/>
        </Border>
        <Border x:Name="RightBorder" Grid.Column="2" BorderBrush="Transparent" BorderThickness="2"
                AllowDrop="True"
                MouseDown="Pane_MouseDown" MouseEnter="Pane_MouseEnter"
                DragEnter="Pane_DragEnter" DragOver="Pane_DragOver" DragLeave="Pane_DragLeave" Drop="Pane_Drop">
            <local:BrowserPane x:Name="RightPane"/>
        </Border>
    </Grid>
</Window>
