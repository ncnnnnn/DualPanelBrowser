<Window x:Class="DualPanelBrowser.ExtensionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扩展管理" Height="500" Width="720"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="BtnInstall" Content="安装扩展(选目录)" Width="130" Height="28"
                    Click="Install_Click" HorizontalAlignment="Left"/>
            <Button x:Name="BtnRefresh" Content="刷新" Width="70" Height="28"
                    Click="Refresh_Click" Margin="8,0,0,0" HorizontalAlignment="Left"/>
            <TextBlock x:Name="StatusText" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="#0a7" FontSize="12"/>
        </DockPanel>
        <ListView x:Name="ExtList" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#999"/>
                        </StackPanel>
                        <Button Grid.Column="1" Width="60" Height="26" Margin="8,0,0,0"
                                Content="选项" Tag="{Binding}" Click="Options_Click"/>
                        <Button Grid.Column="2" Width="70" Height="26" Margin="4,0,0,0"
                                Content="{Binding ToggleText}"
                                Tag="{Binding}" Click="Toggle_Click"/>
                        <Button Grid.Column="3" Width="60" Height="26" Margin="4,0,0,0"
                                Content="删除" Tag="{Binding}" Click="Remove_Click"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</Window>
