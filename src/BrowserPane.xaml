<UserControl x:Class="DualPanelBrowser.BrowserPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewMouseDown="UserControl_PreviewMouseDown">
    <UserControl.Resources>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExtBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8,8,0,0" Padding="12,6" Margin="4,2,0,0" Height="32">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Background" Value="#F3F3F3"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0078D4"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#0078D4"/>
                </MultiTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="0">
        <!-- 工具栏 -->
        <Grid DockPanel.Dock="Top" Background="#F7F7F7">
            <Grid Margin="8,4,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnBack" Grid.Column="0" Style="{StaticResource NavBtn}" Click="Back_Click" ToolTip="Back">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#5F6368" Text="&#xE72B;"/>
                </Button>
                <Button x:Name="BtnFwd" Grid.Column="1" Style="{StaticResource NavBtn}" Click="Fwd_Click" ToolTip="Forward">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#5F6368" Text="&#xE72A;"/>
                </Button>
                <Button x:Name="BtnReload" Grid.Column="2" Style="{StaticResource NavBtn}" Click="Reload_Click" ToolTip="Reload">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#5F6368" Text="&#xE72C;"/>
                </Button>
                <Border Grid.Column="3" Background="White" CornerRadius="17" Height="34" VerticalAlignment="Center"
                        Margin="8,0" BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AddressBox" Grid.Column="0" Padding="12,0" FontSize="13" VerticalContentAlignment="Center"
                                 KeyDown="AddressBox_KeyDown" BorderThickness="0" Background="Transparent"/>
                        <TextBlock x:Name="ZoomLabel" Grid.Column="1" Text="100%" VerticalAlignment="Center"
                                   Margin="0,0,10,0" FontSize="12" Foreground="#888"/>
                    </Grid>
                </Border>
                <Button x:Name="BtnExt" Grid.Column="4" Style="{StaticResource NavBtn}" Click="ExtMenu_Click" ToolTip="菜单">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#5F6368" Text="&#xE7B8;"/>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="MiExt" Header="扩展" Click="Ext_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Grid>
        <!-- 加载进度条（地址栏下方） -->
        <Border DockPanel.Dock="Top" Height="2" Background="Transparent">
            <Border x:Name="ProgressBar" Background="#0078D4" Width="0" HorizontalAlignment="Left"/>
        </Border>
        <!-- 底部扩展状态栏（必须在TabControl之前声明） -->
        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" Height="32" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusLeft" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" Foreground="#888"/>
                <StackPanel x:Name="ExtBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
            </Grid>
        </Border>
        <TabControl x:Name="Tabs" Background="White">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Background="#F7F7F7"
                                   PreviewMouseDown="TabBar_PreviewMouseDown"
                                   PreviewMouseLeftButtonDown="TabBar_PreviewMouseLeftDown">
                            <Button x:Name="BtnNewTab" DockPanel.Dock="Left" Width="32" Height="32"
                                    Click="NewTab_Click" ToolTip="New tab"
                                    Margin="8,0,4,0" BorderThickness="0" Background="Transparent"
                                    Cursor="Hand" VerticalContentAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#666" Text="&#xE710;"/>
                            </Button>
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" AllowDrop="True"/>
                        </DockPanel>
                        <Grid x:Name="ViewHost" Grid.Row="1" Background="White"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
        </TabControl>
    </DockPanel>
</UserControl>
