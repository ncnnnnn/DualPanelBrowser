<UserControl x:Class="DualPanelBrowser.BrowserPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="4">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnBack" Grid.Column="0" Width="32" Height="28" Click="Back_Click" ToolTip="Back"
                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                <Path Data="M15 18l-6-6 6-6" Stroke="#333" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/>
            </Button>
            <Button x:Name="BtnFwd" Grid.Column="1" Width="32" Height="28" Click="Fwd_Click" ToolTip="Forward" Margin="2,0,0,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                <Path Data="M9 18l6-6-6-6" Stroke="#333" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/>
            </Button>
            <Button x:Name="BtnReload" Grid.Column="2" Width="32" Height="28" Click="Reload_Click" ToolTip="Reload" Margin="2,0,0,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                <Path Data="M21 12a9 9 0 1 1-3-6.7L21 8" Stroke="#333" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
            <TextBox x:Name="AddressBox" Grid.Column="3" Margin="6,0" Padding="8,4" FontSize="13"
                     KeyDown="AddressBox_KeyDown" BorderBrush="#DDD" BorderThickness="1"/>
            <Button x:Name="BtnClear" Grid.Column="4" Width="28" Height="28" Click="ClearAddr_Click" ToolTip="Clear"
                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                <Path Data="M18 6L6 18M6 6l12 12" Stroke="#999" StrokeThickness="1.5" StrokeStartLineCap="Round" Stretch="Uniform"/>
            </Button>
            <Button x:Name="BtnExt" Grid.Column="5" Width="32" Height="28" Click="Ext_Click" ToolTip="Extensions" Margin="2,0,0,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                <Path Data="M12 2l2.4 5 5.6.8-4 4 1 5.6L12 14.8 7 17.4l1-5.6-4-4 5.6-.8z" Fill="#555"/>
            </Button>
        </Grid>
        <TabControl x:Name="Tabs" Background="White">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <Button x:Name="BtnNewTab" DockPanel.Dock="Right" Width="36" Height="28" Content="+"
                                    Click="NewTab_Click" ToolTip="New tab"
                                    Margin="2,0,0,0" BorderThickness="0" Background="Transparent"
                                    FontSize="16" VerticalContentAlignment="Center" Cursor="Hand"/>
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True"/>
                        </DockPanel>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
        </TabControl>
    </DockPanel>
</UserControl>
