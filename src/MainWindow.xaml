<Window x:Class="DualPanelBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DualPanelBrowser"
        Title="DualPanel Browser" Height="800" Width="1440"
        WindowStartupLocation="CenterScreen">
    <Grid KeyDown="Window_KeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#E0E0E0"/>
        <Border x:Name="LeftBorder" Grid.Column="0" BorderBrush="Transparent" BorderThickness="2"
                MouseDown="Pane_MouseDown">
            <local:BrowserPane x:Name="LeftPane"/>
        </Border>
        <Border x:Name="RightBorder" Grid.Column="2" BorderBrush="Transparent" BorderThickness="2"
                MouseDown="Pane_MouseDown">
            <local:BrowserPane x:Name="RightPane"/>
        </Border>
    </Grid>
</Window>
